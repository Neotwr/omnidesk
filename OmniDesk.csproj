<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>tool.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  	  
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="tool.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" Condition="Exists('appsettings.json')" />
    <None Include="appsettings.example.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.10" />
  </ItemGroup>

	<ItemGroup>
		<Reference Include="sapnco">
			<HintPath>sapnco.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="sapnco_utils">
			<HintPath>sapnco_utils.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

  <!-- Remove legacy .NET Framework SAP assemblies from WPF XAML Markup compilation to avoid WmiConfigurationAttribute resolution failure -->
  <Target Name="FilterSapFromMarkupCompilePass1" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <_SapReferencePath Include="@(ReferencePath)" Condition="'%(FileName)' == 'sapnco' or '%(FileName)' == 'sapnco_utils'" />
      <ReferencePath Remove="@(_SapReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RestoreSapAfterMarkupCompilePass1" AfterTargets="MarkupCompilePass1">
    <ItemGroup>
      <ReferencePath Include="@(_SapReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="FilterSapFromMarkupCompilePass2" BeforeTargets="MarkupCompilePass2">
    <ItemGroup>
      <ReferencePath Remove="@(_SapReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RestoreSapAfterMarkupCompilePass2" AfterTargets="MarkupCompilePass2">
    <ItemGroup>
      <ReferencePath Include="@(_SapReferencePath)" />
    </ItemGroup>
  </Target>

</Project>
