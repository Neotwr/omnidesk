<Window x:Class="OmniDesk.Views.SapLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniDesk"
        mc:Ignorable="d"
        Title="Login SAP" Height="241" Width="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="25"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15,5,15,16" Height="175">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label 
            Content="Ambiente" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <ComboBox 
            x:Name="cboSapEnv" 
            ItemsSource="{Binding Ambientes}"
            SelectedItem="{Binding AmbienteSelecionado}"
            Text="{Binding AmbienteSelecionado}"
            Grid.Column="1"
            IsEditable="True"
            VerticalContentAlignment="Center"/>

        <Label 
            Content="Cliente" 
            Grid.Row="1" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <TextBox 
            x:Name="txtSapClient" 
            Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="1" 
            Grid.Column="1" 
            MaxLength="3"
            VerticalContentAlignment="Center"/>

        <Label 
            Content="Usuário" 
            Grid.Row="2" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <TextBox 
            x:Name="txtSapUser"
            Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="2" 
            Grid.Column="1" 
            CharacterCasing="Upper"
            VerticalContentAlignment="Center"/>

        <Label 
            Content="Senha" 
            Grid.Row="3" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <PasswordBox 
            x:Name="txtSapPassword" 
            PasswordChanged="TxtSapPassword_PasswordChanged"
            Grid.Row="3" 
            Grid.Column="1" 
            Height="25"
            VerticalContentAlignment="Center"/>

        <Label 
            Content="Idioma" 
            Grid.Row="4" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <TextBox 
            x:Name="txtSapLanguage" 
            Text="{Binding Idioma, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="4" 
            Grid.Column="1" 
            Width="28"
            MaxLength="2" 
            CharacterCasing="Upper" 
            VerticalContentAlignment="Center" 
            HorizontalAlignment="Left" Height="24"/>

        <CheckBox
            x:Name="chkSalvarSenha"
            IsChecked="{Binding LembrarSenha}"
            Content="Lembrar senha"
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Margin="0,2,6,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Padding="1,-1,0,0"/>

        <StackPanel 
            Orientation="Horizontal" 
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Height="27"
            HorizontalAlignment="Left">
            
            <Button
                x:Name="btnCancel"
                Command="{Binding CancelarCommand}"
                Content="Cancelar"
                IsCancel="True"
                Margin="5 0 6 0" 
                Width="59"/>
            <Button
                x:Name="btnLogin"
                Command="{Binding EntrarCommand}"
                Content="Entrar" 
                Width="53"
                IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
