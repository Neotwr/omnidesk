<Window x:Class="OmniDesk.Views.ServiceLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Conta de Serviço" Height="150" Width="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="25"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15,10,15,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>

        <Label 
            Content="Usuário" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <TextBox 
            x:Name="txtServiceUser"
            Grid.Column="1" 
            VerticalContentAlignment="Center"/>

        <Label 
            Content="Senha" 
            Grid.Row="1" 
            VerticalAlignment="Center" 
            Padding="0,5,5,5"/>
        <PasswordBox 
            x:Name="txtServicePassword" 
            Grid.Row="1" 
            Grid.Column="1" 
            Height="25"
            VerticalContentAlignment="Center"/>

        <CheckBox
            x:Name="chkSalvarSenha"
            IsChecked="True"
            Content="Lembrar senha"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,4,0,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Padding="1,-1,0,0"/>

        <StackPanel 
            Orientation="Horizontal" 
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Height="27"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">
            
            <Button
                x:Name="btnCancel"
                Click="BtnCancel_Click"
                Content="Cancelar"
                IsCancel="True"
				Margin="5,0,6,0"
				Width="59"/>
            <Button
                x:Name="btnLogin"
                Click="BtnLogin_Click"
                Content="Salvar" 
                Width="53"
                IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
