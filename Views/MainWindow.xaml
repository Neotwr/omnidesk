<Window
	x:Class="OmniDesk.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:OmniDesk"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="OmniDesk"
	Width="290"
	Height="180"
	ResizeMode="NoResize"
	mc:Ignorable="d">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
	</Window.Resources>

	<Grid>
		<TabControl>
			<!--  guia 1  -->
			<TabItem DataContext="{Binding AcessoRemoto}"
					Header="Acesso remoto">
				<Grid>
					<Grid
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						RowDefinitions="26, 26, 26">

						<StackPanel HorizontalAlignment="Left"
								Orientation="Horizontal">
							<Label Content="Insira o patrimônio ou IP"/>
						</StackPanel>

						<StackPanel Grid.Row="1"
								Orientation="Horizontal">
							<TextBox
								x:Name="txtConnect"
								Width="150"
								Margin="0,0,10,0"
								Text="{Binding Destino, UpdateSourceTrigger=PropertyChanged}">
								<TextBox.InputBindings>
									<KeyBinding Key="Enter"
											Command="{Binding ConectarCommand}"/>
								</TextBox.InputBindings>
							</TextBox>
							<Button
								x:Name="btnConnect"
								Grid.Column="2"
								Width="62"
								Command="{Binding ConectarCommand}"
								Content="Conectar"/>
						</StackPanel>

						<StackPanel
							Grid.Row="2"
							HorizontalAlignment="Left"
							Orientation="Horizontal">
							<RadioButton
								x:Name="rbMsra"
								Content="MSRA"
								GroupName="AccessOption"
								IsChecked="{Binding IsMsra}"/>
							<RadioButton
								x:Name="rbRdp"
								Margin="15,0,0,0"
								Content="RDP"
								GroupName="AccessOption"
								IsChecked="{Binding IsRdp}"/>
						</StackPanel>
					</Grid>

					<Button
						x:Name="btnTrocarLoginServico"
						Width="19"
						Height="19"
						Margin="0,0,6,6"
						Padding="0,0,0,0"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Command="{Binding TrocarLoginServicoCommand}"
						Content="🔑"
						ToolTip="Alterar credenciais / conta de serviço"/>
				</Grid>
			</TabItem>

			<!--  guia 2  -->
			<TabItem DataContext="{Binding ConsultaAcessos}"
					Header="Acessos">
				<Grid
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					RowDefinitions="26, 26, 26, Auto">

					<StackPanel HorizontalAlignment="Left"
							Orientation="Horizontal">
						<Label Content="Insira o usuário"/>
					</StackPanel>

					<StackPanel Grid.Row="1"
							Orientation="Horizontal">
						<TextBox
							x:Name="txtUsuarioAcesso"
							Width="150"
							Margin="0,0,10,0"
							Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}">
							<TextBox.InputBindings>
								<KeyBinding Key="Enter"
										Command="{Binding ConsultarCommand}"/>
							</TextBox.InputBindings>
						</TextBox>
						<Button
							x:Name="btnConsultarAcesso"
							Width="62"
							Command="{Binding ConsultarCommand}"
							Content="Consultar"/>
					</StackPanel>

					<StackPanel
						Grid.Row="2"
						HorizontalAlignment="Left"
						Orientation="Horizontal">
						<RadioButton
							x:Name="rbAcessoAD"
							Content="Grupos AD"
							GroupName="TipoAcesso"
							IsChecked="{Binding IsAdChecked}"/>
						<RadioButton
							x:Name="rbAcessoSenior"
							Margin="10,0,0,0"
							Content="Senior"
							GroupName="TipoAcesso"
							IsChecked="{Binding IsSeniorChecked}"/>
						<RadioButton
							x:Name="rbAcessoSAP"
							Margin="10,0,0,0"
							Content="SAP"
							GroupName="TipoAcesso"
							IsChecked="{Binding IsSapChecked}"/>
					</StackPanel>

					<Grid
						x:Name="pnlAmbienteSap"
						Grid.Row="3"
						Visibility="{Binding IsSapChecked, Converter={StaticResource BoolToVisConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="188"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<ComboBox
							x:Name="cboSapAmbienteAcesso"
							Height="24"
							VerticalContentAlignment="Center"
							IsEditable="True"
							ItemsSource="{Binding Ambientes}"
							SelectedItem="{Binding AmbienteSelecionado}"
							Text="{Binding AmbienteSelecionado}"
							ToolTip="Selecione ou digite o ambiente SAP"/>
						<Button
							x:Name="btnTrocarLoginSap"
							Grid.Column="1"
							Width="28"
							Height="24"
							Margin="6,0,0,0"
							Command="{Binding TrocarLoginSapCommand}"
							Content="🔑"
							ToolTip="Alterar credenciais / conta deste ambiente"/>
					</Grid>
				</Grid>
			</TabItem>

			<!--  guia 3  -->
			<TabItem DataContext="{Binding ComparadorGrupos}"
					Header="Comparar">
				<Grid
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					RowDefinitions="*, *, *">

					<StackPanel Orientation="Horizontal">
						<Label
							Width="50"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Content="Usuário"/>
						<TextBox
							x:Name="txtUserA"
							Width="135"
							Height="26"
							Margin="1,2,2,1"
							Text="{Binding UsuarioAlvo, UpdateSourceTrigger=PropertyChanged}">
							<TextBox.InputBindings>
								<KeyBinding Key="Enter"
										Command="{Binding CompararCommand}"/>
							</TextBox.InputBindings>
						</TextBox>
					</StackPanel>

					<StackPanel
						Grid.Row="1"
						Margin="0,0,0,2"
						Orientation="Horizontal">
						<Label
							Width="50"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Content="Ref."/>
						<TextBox
							x:Name="txtUserB"
							Width="135"
							Height="26"
							Margin="1,2,28,1"
							Text="{Binding UsuarioReferencia, UpdateSourceTrigger=PropertyChanged}">
							<TextBox.InputBindings>
								<KeyBinding Key="Enter"
										Command="{Binding CompararCommand}"/>
							</TextBox.InputBindings>
						</TextBox>

					</StackPanel>

					<Button
						x:Name="btnComparar"
						Grid.Row="2"
						Width="58"
						Height="26"
						Margin="0,0,2,0"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Command="{Binding CompararCommand}"
						Content="Comparar"
						UseLayoutRounding="False"/>

					<StackPanel
						Grid.Row="2"
						VerticalAlignment="Center"
						Orientation="Horizontal">
						<RadioButton
							x:Name="rbCompararAD"
							Margin="2,0,0,0"
							Content="AD"
							GroupName="TipoComparacao"
							IsChecked="{Binding IsAdChecked}"/>

						<RadioButton
							x:Name="rbCompararSenior"
							Margin="11,0,7,0"
							Content="Senior"
							GroupName="TipoComparacao"
							IsChecked="{Binding IsSeniorChecked}"/>

						<RadioButton
							x:Name="rbCompararSAP"
							Content="SAP"
							GroupName="TipoComparacao"
							IsChecked="{Binding IsSapChecked}"/>
					</StackPanel>

				</Grid>
			</TabItem>

			<TabItem Header="Utils"
					 DataContext="{Binding Utils}">

				<StackPanel>
					<TextBlock
						Margin="0,6,0,4"
						HorizontalAlignment="Center"
						FontWeight="Bold"
						Text="Utilitário"/>

					<UniformGrid
						Height="100"
						Margin="15,0,15,0"
						Columns="3">
						<UniformGrid.Resources>
							<Style BasedOn="{StaticResource PainelButtonStyle}"
									TargetType="Button"/>
						</UniformGrid.Resources>

						<Button x:Name="btnGC"
								Content="Gerenciar computador"
								CommandParameter="compmgmt.msc"/>
						<Button x:Name="btnAD"
								Content="Active Directory"
								CommandParameter="dsa.msc"/>
						<Button x:Name="btnRDP"
								Content="Remote Desktop"
								CommandParameter="mstsc.exe"/>
						<Button IsEnabled="False"/>
						<Button IsEnabled="False"/>
						<Button IsEnabled="False"/>

					</UniformGrid>
				</StackPanel>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
