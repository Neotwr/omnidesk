<Window x:Class="RemoteAccessUtil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemoteAccessUtil"
        mc:Ignorable="d"
        Title="Util" Height="160" Width="280" ResizeMode="NoResize">
    <Grid>
        <TabControl >
            <TabItem Header="Acesso remoto">
                <StackPanel>
                    <Label
                        Content="Insira o patrimônio ou IP"
                        Height="28" Width="150"/>
                    <TextBox
                        x:Name="txtConnect"
                        Height="26" Width="188"
                        KeyDown="BxtConnect_KeyDown"/>
                    <Button
                        x:Name="btnConnect"
                        Content="Conectar"
                        Height="27" 
                        Width="114"
                        Click="BtnConnect_Click"
                        Margin="0 4 0 0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Grupos">
                <Grid
                    RowDefinitions="Auto, Auto, *"
                    ColumnDefinitions="Auto, *, Auto"
                    VerticalAlignment="Center" >
                 
                    <Label
                        Content="Usuário"
                        Grid.Column="0"/>
                    <TextBox
                        x:Name="txtUserA"
                        Grid.Column="1" 
                        Margin="1 2 2 1"/>
                    <Button 
                        x:Name="btnSearchA"
                        Click="BtnSearchA_Click"
                        Content="🔍"
                        ToolTip="Procurar"
                        FontSize="16"
                        Grid.Column="2" 
                        Margin="1 2 2 1"/>

                    <Label 
                        Content="Ref." 
                        Grid.Row="1" 
                        Grid.Column="0"/>
                    <TextBox 
                        x:Name="txtUserB"
                        Grid.Row="1" 
                        Grid.Column="1" 
                        Margin="1 2 2 1"/>
                    <Button 
                        x:Name="btnSearchB"
                        Click="BtnSearchB_Click"
                        Content="🔍"
                        ToolTip="Procurar"
                        FontSize="16"
                        Grid.Row="1" 
                        Grid.Column="2" 
                        Margin="1 2 2 1"/>

                    <Button 
                        x:Name="btnComparar"
                        Click="BtnComparar_Click"
                        Content="Comparar" 
                        Grid.Row="2" 
                        Grid.Column="1" 
                        Height="27"
                        Width="114" 
                        Margin="0 3 0 0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
