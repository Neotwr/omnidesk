<Window x:Class="RemoteAccessUtil.GruposWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RemoteAccessUtil"
        mc:Ignorable="d"
        Title="Grupos do Usuário" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="Auto, *"
        Margin="10,10,10,10">

        <TextBox x:Name="txtBusca" 
             Padding="5" 
             Margin="0,0,0,5"
             TextChanged="TxtBusca_TextChanged" 
             Width="260"/>

        <TextBlock Text="Digite para buscar um grupo..." 
               Foreground="Gray" 
               Margin="10,0,0,5" 
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Width="220">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <Setter Property="Visibility" Value="Hidden"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtBusca}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>

                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Label x:Name="lblDescricao"
               Content=""
               Grid.Column="1"
               HorizontalContentAlignment="Right"/>

        <DataGrid x:Name="dgGrupos"
          Grid.Row="1"
          Grid.ColumnSpan="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          AlternatingRowBackground="#FFF0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome do Grupo" Binding="{Binding Nome}" Width="200"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
